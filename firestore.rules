rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    
    // Check if user is authenticated (any method, including anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get the user's role from the root-level /users collection
    // Faculty users have role='faculty', set during credential creation
    function getRootUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Check if the authenticated user is a faculty member
    function isFaculty() {
      return isAuthenticated() && getRootUserRole() == 'faculty';
    }

    // ===== ROOT-LEVEL COLLECTIONS =====

    // Root users collection (Firebase Auth role mapping)
    // Any authenticated user can read (role verification)
    // Any authenticated user can write (admin creates faculty docs via anonymous auth)
    // Admin password is the real security gate — rules just block unauthenticated access
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // App configuration (admin password hash, feature flags)
    // All authenticated users can read (admin login needs this)
    // Only faculty can write (change admin password)
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();  // Admin sets this before faculty role exists
    }

    // ===== DEPARTMENT-SCOPED COLLECTIONS =====
    
    match /departments/{deptId} {
      // Department document itself
      allow read: if isAuthenticated();
      allow write: if isFaculty();

      // --- Teacher Credentials (ADMIN & FACULTY WRITE) ---
      // Any authenticated user can write (admin uses anonymous auth to create credentials)
      // Only authenticated users can read (credential check during teacher login)
      // Admin password gate is the real security layer
      match /teacher_credentials/{credId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // --- Batches ---
      match /batches/{batchId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Students ---
      match /students/{studentId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Subjects ---
      match /subjects/{subjectId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- IA Marks ---
      match /marks/{markId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Final Exam Marks ---
      match /finalExamMarks/{markId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Semester Results (SGPA/CGPA) ---
      match /semesterResults/{resultId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Public Ranks ---
      match /publicRanks/{rankId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Absentees (daily attendance) ---
      match /absentees/{absenteeId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }
      
      // --- Monthly Attendance ---
      match /attendanceMonthly/{attId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- IA Question Configs ---
      match /ia_configs/{configId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- IA Question Details ---
      match /ia_details/{detailId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- User Metadata (department-scoped) ---
      // Faculty writes student user docs during USN-based login
      match /users/{userId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }

      // --- Admin Config (hashed admin password) ---
      match /appConfig/{configId} {
        allow read: if isAuthenticated();
        allow write: if isFaculty();
      }
    }
  }
}